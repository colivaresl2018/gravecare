rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esStaff() {
      return estaAutenticado() && 
        (request.auth.token.staff == true || 
         request.auth.token.admin == true ||
         request.auth.token.email in ['contacto@gravecare.cl', 'admin@gravecare.cl', 'rravellos@gmail.com', 'colivaresl@hotmail.com']);
    }

    function esDueno(userId) {
      return estaAutenticado() && request.auth.uid == userId;
    }

    // --- GASTOS E INGRESOS (CONTABILIDAD Y TRIBUTARIO) ---
    match /gastos_ingresos/{docId} {
      allow read: if true;
      allow create, update: if estaAutenticado() || esStaff() || true;
      allow delete: if estaAutenticado() || esStaff();
    }

    // Colección de respaldo 'gastos'
    match /gastos/{docId} {
      allow read: if true;
      allow create, update: if estaAutenticado() || esStaff() || true;
      allow delete: if estaAutenticado() || esStaff();
    }

    // --- USUARIOS Y TODAS SUS SUBCOLECCIONES (INCLUYENDO SEPULTURAS) ---
    match /usuarios/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if esStaff();

      // Regla recursiva para sepulturas u otras subcolecciones del cliente
      match /{allSubcollections=**} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if esStaff();
      }
    }

    // --- CONTRATOS ---
    match /contratos/{contratoId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if esStaff();
    }

    // --- STAFF ---
    match /staff/{staffId} {
      allow read: if estaAutenticado() || true;
      allow write: if esStaff();
    }

    // --- RUT LOOKUP ---
    match /rut_lookup/{rut} {
      allow read: if true;
      allow create, update: if estaAutenticado() || true;
      allow delete: if esStaff();
    }

    // --- ÓRDENES ---
    match /ordenes/{ordenId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if esStaff();
    }

    // --- INFORMES Y CERTIFICADOS ---
    match /informes/{informeId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if esStaff();
    }

    // --- PAGOS ---
    match /pagos/{pagoId} {
      allow read: if true;
      allow write: if false;
    }

    // --- TRABAJOS ---
    match /trabajos/{trabajoId} {
      allow read: if true;
      allow write: if estaAutenticado() || esStaff();
    }

    // --- COLECCIÓN GLOBAL SEPULTURAS (SI SE CONSULTA EN RAÍZ) ---
    match /sepulturas/{sepId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if esStaff();
    }

  }
}