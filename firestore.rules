rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección de perfiles de usuarios
    match /usuarios/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Índice público de resolución de RUT a Correo (para permitir login con RUT)
    match /rut_lookup/{rut} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // ============== COLECCIONES DE GRAVECARE SYSTEM ==============
    
    // Servicios/Planificación
    match /servicios/{servicioId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Pedidos de Flores
    match /pedidos_flores/{pedidoId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Operadores
    match /operadores/{operadorId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Programas de Visitas enviados
    match /programas_visitas/{programaId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Registros de Servicios (terreno)
    match /registros_servicio/{registroId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Revisiones y Supervisión
    match /revisiones/{revisionId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Bloqueo por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
