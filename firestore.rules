rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esStaff() {
      return estaAutenticado() && 
        (request.auth.token.staff == true || 
         request.auth.token.admin == true ||
         request.auth.token.email in ['contacto@gravecare.cl']);
    }

    function esDueno(userId) {
      return estaAutenticado() && request.auth.uid == userId;
    }

    // --- USUARIOS ---
    match /usuarios/{userId} {
      // Lectura: staff, dueño de la cuenta, o consulta pública para verificación/precarga
      allow read: if esDueno(userId) || esStaff() || true;
      // Creación: permite a un nuevo usuario autenticado registrar su propio perfil
      allow create: if estaAutenticado() && request.auth.uid == userId;
      allow update: if esDueno(userId) || esStaff();
      allow delete: if esStaff();
    }

    // --- RUT LOOKUP (Verificación de existencia) ---
    match /rut_lookup/{rut} {
      // Permite leer para validar duplicidad en el formulario de registro
      allow read: if true;
      // Escritura permitida si el usuario está registrando su cuenta o desde backend
      allow create, update: if estaAutenticado() || true;
      allow delete: if esStaff();
    }

    // --- ÓRDENES ---
    match /ordenes/{ordenId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if esStaff();
    }

    // --- PAGOS ---
    match /pagos/{pagoId} {
      allow read: if esStaff() || (estaAutenticado() && resource.data.usuarioId == request.auth.uid);
      allow write: if false;
    }

    // --- TRABAJOS / OPERACIONES ---
    match /trabajos/{trabajoId} {
      allow read: if esStaff() || (estaAutenticado() && resource.data.clienteUid == request.auth.uid);
      allow write: if esStaff();
    }

  }
}