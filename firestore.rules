rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esStaff() {
      return estaAutenticado() && 
        (request.auth.token.staff == true || 
         request.auth.token.admin == true ||
         request.auth.token.email in ['contacto@gravecare.cl']); // Agrega tus correos admin
    }

    function esDueno(userId) {
      return estaAutenticado() && request.auth.uid == userId;
    }

    // --- USUARIOS ---
    match /usuarios/{userId} {
      allow read: if esDueno(userId) || esStaff();
      allow create: if esDueno(userId);
      allow update: if esDueno(userId) || esStaff();
      allow delete: if esStaff();
    }

    // --- RUT LOOKUP (Índice sensible) ---
    match /rut_lookup/{rut} {
      allow read: if estaAutenticado();
      // Escritura bloqueada desde cliente: solo Cloud Functions (Admin SDK)
      allow write: if false;
    }

    // --- ÓRDENES ---
    match /ordenes/{ordenId} {
      allow read: if esStaff() || (estaAutenticado() && resource.data.usuarioId == request.auth.uid);
      allow create: if estaAutenticado() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if esStaff();
      allow delete: if esStaff();
    }

    // --- PAGOS ---
    match /pagos/{pagoId} {
      allow read: if esStaff() || (estaAutenticado() && resource.data.usuarioId == request.auth.uid);
      // Los registros de pago los confirma Webpay vía Cloud Function (Admin SDK)
      allow write: if false;
    }

    // --- TRABAJOS / OPERACIONES ---
    match /trabajos/{trabajoId} {
      allow read: if esStaff() || (estaAutenticado() && resource.data.clienteUid == request.auth.uid);
      allow write: if esStaff();
    }
  }
}