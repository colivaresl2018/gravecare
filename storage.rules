rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de reportes (antes/después de cada trabajo).
    //
    // ⚠️ La ruta real que sube informe-captura.html es
    // informes/{ordenId}/{archivo} (no "reportes/{numeroOrden}/..."). La
    // regla decía "reportes" y nunca coincidía con ninguna subida real, así
    // que todo caía al bloqueo por defecto de más abajo (allow: if false) y
    // las fotos fallaban en silencio con error de permisos. Se corrigió el
    // nombre de la ruta para que coincida con el código — si algún día se
    // renombra la carpeta en el código, hay que replicar el cambio aquí.
    match /informes/{ordenId}/{archivo} {
      // Lectura: cualquiera con el link puede VER la foto (así las URLs
      // funcionan directo en el dashboard del cliente sin pedir token).
      // Nadie puede "listar" el contenido de la carpeta sin el link exacto.
      allow read: if true;

      // Escritura: solo staff activo (Operador, Supervisor o Administrador),
      // verificado contra la colección "staff" en Firestore.
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.activo == true &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Bloqueo por defecto para cualquier otra ruta
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
