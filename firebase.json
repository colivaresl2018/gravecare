{
  "hosting": {
    "target": "publico",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/webpayCrear",
        "function": "webpayCrear"
      },
      {
        "source": "/webpayConfirmar",
        "function": "webpayConfirmar"
      },
      {
        "source": "/oneclickInscribir",
        "function": "oneclickInscribir"
      },
      {
        "source": "/oneclickInscripcionFinalizar",
        "function": "oneclickInscripcionFinalizar"
      },
      {
        "source": "/enviarContacto",
        "function": "enviarContacto"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
