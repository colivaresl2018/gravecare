{
  "hosting": {
    "target": "publico",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/crearTransaccionWebpay",
        "function": "crearTransaccionWebpay"
      },
      {
        "source": "/crear-transaccion-webpay",
        "function": "crearTransaccionWebpay"
      },
      {
        "source": "/confirmarTransaccionWebpay",
        "function": "confirmarTransaccionWebpay"
      },
      {
        "source": "/confirmar-transaccion-webpay",
        "function": "confirmarTransaccionWebpay"
      },
      {
        "source": "/iniciarInscripcionOneclick",
        "function": "iniciarInscripcionOneclick"
      },
      {
        "source": "/iniciar-inscripcion-oneclick",
        "function": "iniciarInscripcionOneclick"
      },
      {
        "source": "/confirmarInscripcionOneclick",
        "function": "confirmarInscripcionOneclick"
      },
      {
        "source": "/confirmar-inscripcion-oneclick",
        "function": "confirmarInscripcionOneclick"
      },
      {
        "source": "/enviarContacto",
        "function": "enviarContacto"
      },
      {
        "source": "/confirmar-pago.html",
        "destination": "/confirmacion.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}